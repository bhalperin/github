{
	"name": "ui",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"prefix": "gh",
	"sourceRoot": "apps/ui/src",
	"tags": ["scope:app"],
	"targets": {
		"build": {
			"executor": "@angular-devkit/build-angular:application",
			"outputs": ["{options.outputPath}"],
			"defaultConfiguration": "production",
			"options": {
				"outputPath": "dist/apps/ui",
				"index": "apps/ui/src/index.html",
				"browser": "apps/ui/src/main.ts",
				"polyfills": [],
				"tsConfig": "apps/ui/tsconfig.app.json",
				"inlineStyleLanguage": "scss",
				"assets": ["apps/ui/src/favicon.ico", "apps/ui/src/assets"],
				"styles": ["apps/ui/src/styles.scss"],
				"scripts": []
			},
			"configurations": {
				"production": {
					"budgets": [
						{
							"type": "initial",
							"maximumWarning": "500kb",
							"maximumError": "1mb"
						},
						{
							"type": "anyComponentStyle",
							"maximumWarning": "2kb",
							"maximumError": "4kb"
						}
					],
					"outputHashing": "all"
				},
				"development": {
					"optimization": false,
					"extractLicenses": false,
					"sourceMap": true
				}
			}
		},
		"serve": {
			"executor": "@angular-devkit/build-angular:dev-server",
			"defaultConfiguration": "development",
			"options": {
				"proxyConfig": "apps/ui/proxy.conf.json"
			},
			"configurations": {
				"production": {
					"buildTarget": "ui:build:production"
				},
				"development": {
					"buildTarget": "ui:build:development"
				}
			}
		},
		"extract-i18n": {
			"executor": "@angular-devkit/build-angular:extract-i18n",
			"options": {
				"buildTarget": "ui:build"
			}
		},
		"test": {
			"executor": "@nx/vitest:test",
			"options": {
				"tsConfig": "apps/ui/tsconfig.spec.json",
				"configFile": "{workspaceRoot}/{projectRoot}/vite.config.mts"
			}
		}
	}
}
